+/* Parse one 64-bit unsigned value: decimal or 0x-prefixed hex.
+ * Returns TRUE on success. */
+static bool quic_fp_parse_u64(const char *str, uint64_t *pval)
+{
+  char *endptr = NULL;
+
+  if(!str || !*str)
+    return FALSE;
+  errno = 0;
+  *pval = strtoull(str, &endptr, 0);
+  if(errno || endptr == str || *endptr)
+    return FALSE;
+  return TRUE;
+}
+
+/* Fill |buf| (len bytes) with random data. */
+static CURLcode quic_fp_rand(struct Curl_easy *data, uint8_t *buf, size_t len)
+{
+  return Curl_rand(data, buf, len);
+}
+
+/* Fill |pval| with a random GREASE-style value. */
+static void quic_fp_grease_u64(struct Curl_easy *data, uint64_t *pval)
+{
+  uint8_t buf[8];
+
+  if(Curl_rand(data, buf, sizeof(buf)) != CURLE_OK)
+    memset(buf, 0, sizeof(buf));
+  buf[0] = (uint8_t)(0x10 | (buf[0] & 0x0f));
+  *pval = 0;
+  {
+    size_t i;
+    for(i = 0; i < sizeof(buf); ++i)
+      *pval = (*pval << 8) | buf[i];
+  }
+}
+
+/* Fisher-Yates shuffle of |idx[0..n-1]| using curl's RNG. */
+static void quic_fp_shuffle(struct Curl_easy *data, size_t *idx, size_t n)
+{
+  size_t i;
+
+  for(i = n - 1; i > 0; --i) {
+    uint8_t rbuf[2];
+    size_t j;
+
+    if(Curl_rand(data, rbuf, sizeof(rbuf)) != CURLE_OK)
+      rbuf[0] = rbuf[1] = 0;
+    j = (size_t)(rbuf[0] | ((size_t)rbuf[1] << 8)) % (i + 1);
+    {
+      size_t t = idx[i];
+      idx[i] = idx[j];
+      idx[j] = t;
+    }
+  }
+}
+
+/* Fill |pval| with a GREASE SETTINGS ID that fingerprinting services
+ * recognize as GREASE.  The two known-good IDs are the ones observed in
+ * the Chrome 151 samples (0x19b4c8cd6 and 0x17c1d7fd48); Chrome picks
+ * one per connection, so we rotate randomly. */
+static void quic_fp_grease_settings_id(struct Curl_easy *data, uint64_t *pval)
+{
+  static const uint64_t known_grease_ids[2] = {
+      UINT64_C(0x19b4c8cd6), UINT64_C(0x17c1d7fd48)};
+  uint8_t r;
+
+  if(Curl_rand(data, &r, 1) != CURLE_OK)
+    r = 0;
+  *pval = known_grease_ids[r & 1];
+}
+
+/* Parse CURLOPT_HTTP3_FP_QUIC: "scid=<len>" sets the client source
+ * connection ID length (0-20). */
+static CURLcode quic_fp_parse_quic(struct cf_ngtcp2_ctx *ctx,
+                                   struct Curl_easy *data)
+{
+  const char *opt = data->set.str[STRING_HTTP3_FP_QUIC];
+  uint64_t len;
+
+  ctx->fp_scid_len = NGTCP2_MAX_CIDLEN;
+  if(!opt || !*opt)
+    return CURLE_OK;
+
+  if(strncmp(opt, "scid=", 5) || !quic_fp_parse_u64(opt + 5, &len) ||
+     len > NGTCP2_MAX_CIDLEN) {
+    failf(data, "invalid CURLOPT_HTTP3_FP_QUIC: '%s' "
+          "(expected \"scid=<0..%d>\")", opt, NGTCP2_MAX_CIDLEN);
+    return CURLE_BAD_FUNCTION_ARGUMENT;
+  }
+  ctx->fp_scid_len = (size_t)len;
+  infof(data, "HTTP/3 fp: source connection ID length %zu", ctx->fp_scid_len);
+  return CURLE_OK;
+}
+
+/* Parse CURLOPT_HTTP3_FP_SETTINGS: "id:value;id:value;..." in wire order.
+ * The keyword GREASE inserts a random unknown setting. Standard IDs also
+ * update the nghttp3 settings fields so protocol behaviour stays
+ * consistent with the advertised values. */
+static CURLcode quic_fp_parse_settings(struct cf_ngtcp2_ctx *ctx,
+                                       struct Curl_easy *data)
+{
+  const char *opt = data->set.str[STRING_HTTP3_FP_SETTINGS];
+  const char *p, *end;
+
+  ctx->fp_h3_settings_len = 0;
+  if(!opt || !*opt)
+    return CURLE_OK;
+
+  p = opt;
+  while(*p) {
+    const char *sep;
+    uint64_t id, value;
+    nghttp3_settings_entry *ent;
+
+    if(ctx->fp_h3_settings_len >= NGHTTP3_FP_MAX_SETTINGS) {
+      failf(data, "too many CURLOPT_HTTP3_FP_SETTINGS entries");
+      return CURLE_BAD_FUNCTION_ARGUMENT;
+    }
+    sep = strchr(p, ';');
+    end = sep ? sep : p + strlen(p);
+
+    if(end - p >= 6 && !strncmp(p, "GREASE", 6)) {
+      ent = &ctx->fp_h3_settings[ctx->fp_h3_settings_len++];
+      quic_fp_grease_settings_id(data, &ent->id);
+      quic_fp_grease_u64(data, &ent->value);
+    }
+    else {
+      const char *colon = memchr(p, ':', (size_t)(end - p));
+      char idbuf[32];
+      char valbuf[32];
+
+      if(!colon || (size_t)(colon - p) >= sizeof(idbuf) ||
+         (size_t)(end - colon - 1) >= sizeof(valbuf)) {
+        failf(data, "invalid CURLOPT_HTTP3_FP_SETTINGS entry: '%.*s'",
+              (int)(end - p), p);
+        return CURLE_BAD_FUNCTION_ARGUMENT;
+      }
+      memcpy(idbuf, p, (size_t)(colon - p));
+      idbuf[colon - p] = '\0';
+      memcpy(valbuf, colon + 1, (size_t)(end - colon - 1));
+      valbuf[end - colon - 1] = '\0';
+      if(!quic_fp_parse_u64(idbuf, &id) || !quic_fp_parse_u64(valbuf, &value)) {
+        failf(data, "invalid CURLOPT_HTTP3_FP_SETTINGS entry: '%.*s'",
+              (int)(end - p), p);
+        return CURLE_BAD_FUNCTION_ARGUMENT;
+      }
+      ent = &ctx->fp_h3_settings[ctx->fp_h3_settings_len++];
+      ent->id = id;
+      ent->value = value;
+    }
+
+    if(!sep)
+      break;
+    p = sep + 1;
+  }
+  infof(data, "HTTP/3 fp: %zu SETTINGS entries configured",
+        ctx->fp_h3_settings_len);
+  return CURLE_OK;
+}
+
+/* Parse one CURLOPT_HTTP3_FP_TRANSPORT_PARAMS value into the next entry.
+ * Returns TRUE on success. */
+static bool quic_fp_parse_tp_value(struct cf_ngtcp2_ctx *ctx,
+                                   struct Curl_easy *data,
+                                   const char *val, size_t vallen,
+                                   ngtcp2_tp_entry *ent)
+{
+  if(vallen == 6 && !strncmp(val, "GREASE", 6)) {
+    ent->type = NGTCP2_TP_ENTRY_TYPE_GREASE;
+    return TRUE;
+  }
+  if(vallen == 4 && !strncmp(val, "AUTO", 4)) {
+    ent->type = NGTCP2_TP_ENTRY_TYPE_CID;
+    return TRUE;
+  }
+  if(memchr(val, '@', vallen)) {
+    /* version_information: chosen@v1,v2,... */
+    const char *at = memchr(val, '@', vallen);
+    const char *lp = at + 1;
+    char buf[32];
+    uint64_t chosen;
+
+    if((size_t)(at - val) >= sizeof(buf)) {
+      failf(data, "invalid version_information value '%.*s'",
+            (int)vallen, val);
+      return FALSE;
+    }
+    memcpy(buf, val, (size_t)(at - val));
+    buf[at - val] = '\0';
+    if(!quic_fp_parse_u64(buf, &chosen)) {
+      failf(data, "invalid version_information value '%.*s'",
+            (int)vallen, val);
+      return FALSE;
+    }
+    ent->type = NGTCP2_TP_ENTRY_TYPE_VERSION_INFO;
+    ent->value = chosen;
+    ent->data = ctx->fp_tp_blob + ctx->fp_tp_blob_len;
+    ent->datalen = 0;
+    while(lp < val + vallen) {
+      const char *comma = memchr(lp, ',', (size_t)(val + vallen - lp));
+      const char *vend = comma ? comma : val + vallen;
+      uint64_t v;
+
+      if((size_t)(vend - lp) >= sizeof(buf)) {
+        failf(data, "invalid version_information value '%.*s'",
+              (int)vallen, val);
+        return FALSE;
+      }
+      memcpy(buf, lp, (size_t)(vend - lp));
+      buf[vend - lp] = '\0';
+      if(strcmp(buf, "GREASE")) {
+        uint8_t vbuf[4];
+        if(!quic_fp_parse_u64(buf, &v)) {
+          failf(data, "invalid version_information value '%.*s'",
+                (int)vallen, val);
+          return FALSE;
+        }
+        if(ctx->fp_tp_blob_len + 4 > sizeof(ctx->fp_tp_blob)) {
+          failf(data, "CURLOPT_HTTP3_FP_TRANSPORT_PARAMS too long");
+          return FALSE;
+        }
+        vbuf[0] = (uint8_t)(v >> 24);
+        vbuf[1] = (uint8_t)(v >> 16);
+        vbuf[2] = (uint8_t)(v >> 8);
+        vbuf[3] = (uint8_t)v;
+        memcpy(ctx->fp_tp_blob + ctx->fp_tp_blob_len, vbuf, 4);
+        ctx->fp_tp_blob_len += 4;
+        ent->datalen += 4;
+      }
+      else {
+        /* GREASE version: 0x?a?a?a?a pattern */
+        uint8_t gbuf[4];
+        if(Curl_rand(data, gbuf, 4) != CURLE_OK)
+          memset(gbuf, 0, 4);
+        gbuf[0] = (uint8_t)(0x0a | (gbuf[0] & 0xf0));
+        gbuf[1] = (uint8_t)(0x1a | (gbuf[1] & 0xf0));
+        gbuf[2] = (uint8_t)(0x2a | (gbuf[2] & 0xf0));
+        gbuf[3] = (uint8_t)(0x3a | (gbuf[3] & 0xf0));
+        if(ctx->fp_tp_blob_len + 4 > sizeof(ctx->fp_tp_blob)) {
+          failf(data, "CURLOPT_HTTP3_FP_TRANSPORT_PARAMS too long");
+          return FALSE;
+        }
+        memcpy(ctx->fp_tp_blob + ctx->fp_tp_blob_len, gbuf, 4);
+        ctx->fp_tp_blob_len += 4;
+        ent->datalen += 4;
+      }
+      if(!comma)
+        break;
+      lp = comma + 1;
+    }
+    /* Chrome randomizes whether the GREASE version comes first or last
+       in the available versions list */
+    if(ctx->fp_rand && ent->datalen >= 8) {
+      uint8_t r;
+
+      if(Curl_rand(data, &r, 1) != CURLE_OK)
+        r = 0;
+      if(r & 1) {
+        uint8_t tmp[4];
+        memcpy(tmp, ent->data, 4);
+        memcpy((uint8_t *)ent->data, ent->data + ent->datalen - 4, 4);
+        memcpy((uint8_t *)ent->data + 4, tmp, 4);
+      }
+    }
+    return TRUE;
+  }
+  if(vallen > 2 && val[0] == '0' && (val[1] == 'x' || val[1] == 'X')) {
+    /* 0x-prefixed value: the hex string IS the value bytes (Chrome sends
+       google_connection_options as raw bytes, not a varint) */
+    size_t nbytes = (vallen - 2) / 2;
+    size_t i;
+
+    if((vallen - 2) % 2 || !nbytes ||
+       ctx->fp_tp_blob_len + nbytes > sizeof(ctx->fp_tp_blob)) {
+      failf(data, "invalid transport parameter value '%.*s'",
+            (int)vallen, val);
+      return FALSE;
+    }
+    ent->type = NGTCP2_TP_ENTRY_TYPE_RAW;
+    ent->data = ctx->fp_tp_blob + ctx->fp_tp_blob_len;
+    ent->datalen = nbytes;
+    for(i = 0; i < nbytes; ++i) {
+      char hex[3] = {val[2 + i * 2], val[2 + i * 2 + 1], '\0'};
+      char *endptr = NULL;
+      unsigned long b = strtoul(hex, &endptr, 16);
+      if(endptr != hex + 2) {
+        failf(data, "invalid transport parameter value '%.*s'",
+              (int)vallen, val);
+        return FALSE;
+      }
+      ctx->fp_tp_blob[ctx->fp_tp_blob_len + i] = (uint8_t)b;
+    }
+    ctx->fp_tp_blob_len += nbytes;
+    return TRUE;
+  }
+  {
+    char buf[32];
+    uint64_t value;
+
+    /* |val| is not null-terminated: copy before parsing */
+    if(vallen >= sizeof(buf)) {
+      failf(data, "invalid transport parameter value '%.*s'",
+            (int)vallen, val);
+      return FALSE;
+    }
+    memcpy(buf, val, vallen);
+    buf[vallen] = '\0';
+    if(!quic_fp_parse_u64(buf, &value)) {
+      failf(data, "invalid transport parameter value '%.*s'",
+            (int)vallen, val);
+      return FALSE;
+    }
+    ent->type = NGTCP2_TP_ENTRY_TYPE_VARINT;
+    ent->value = value;
+    return TRUE;
+  }
+}
+
+/* Parse CURLOPT_HTTP3_FP_TRANSPORT_PARAMS: "id:value;id:value;..." in wire
+ * order, and mirror the standard values into the ngtcp2 transport params so
+ * flow control etc. matches what is advertised. */
+static CURLcode quic_fp_parse_tp(struct cf_ngtcp2_ctx *ctx,
+                                 struct Curl_easy *data,
+                                 ngtcp2_transport_params *t)
+{
+  const char *opt = data->set.str[STRING_HTTP3_FP_TRANSPORT_PARAMS];
+  const char *p;
+
+  ctx->fp_tp_len = 0;
+  ctx->fp_tp_blob_len = 0;
+  if(!opt || !*opt)
+    return CURLE_OK;
+
+  p = opt;
+  while(*p) {
+    const char *sep = strchr(p, ';');
+    const char *end = sep ? sep : p + strlen(p);
+    const char *colon = memchr(p, ':', (size_t)(end - p));
+    ngtcp2_tp_entry *ent;
+    uint64_t id;
+
+    if(ctx->fp_tp_len >= NGTCP2_FP_MAX_TP) {
+      failf(data, "too many CURLOPT_HTTP3_FP_TRANSPORT_PARAMS entries");
+      return CURLE_BAD_FUNCTION_ARGUMENT;
+    }
+    ent = &ctx->fp_tp[ctx->fp_tp_len];
+    ent->id = 0;
+    ent->value = 0;
+    ent->data = NULL;
+    ent->datalen = 0;
+    if(!colon && end - p == 6 && !strncmp(p, "GREASE", 6)) {
+      /* bare GREASE transport parameter */
+      ent->type = NGTCP2_TP_ENTRY_TYPE_GREASE;
+      ctx->fp_tp_len++;
+      if(!sep)
+        break;
+      p = sep + 1;
+      continue;
+    }
+    if(colon && (size_t)(colon - p) < 32) {
+      char idbuf[32];
+      memcpy(idbuf, p, (size_t)(colon - p));
+      idbuf[colon - p] = '\0';
+      if(quic_fp_parse_u64(idbuf, &id)) {
+        ent->id = id;
+        if(!quic_fp_parse_tp_value(ctx, data, colon + 1,
+                                   (size_t)(end - colon - 1), ent))
+          return CURLE_BAD_FUNCTION_ARGUMENT;
+        ctx->fp_tp_len++;
+
+        /* mirror standard values so internal flow control stays sane */
+        switch(id) {
+        case 0x1: /* max_idle_timeout (ms) -> ngtcp2 duration (ns) */
+          if(ent->type == NGTCP2_TP_ENTRY_TYPE_VARINT)
+            t->max_idle_timeout = ent->value * NGTCP2_SECONDS / 1000;
+          break;
+        case 0x3:
+          if(ent->type == NGTCP2_TP_ENTRY_TYPE_VARINT)
+            t->max_udp_payload_size = ent->value;
+          break;
+        case 0x4:
+          if(ent->type == NGTCP2_TP_ENTRY_TYPE_VARINT)
+            t->initial_max_data = ent->value;
+          break;
+        case 0x5:
+          if(ent->type == NGTCP2_TP_ENTRY_TYPE_VARINT)
+            t->initial_max_stream_data_bidi_local = ent->value;
+          break;
+        case 0x6:
+          if(ent->type == NGTCP2_TP_ENTRY_TYPE_VARINT)
