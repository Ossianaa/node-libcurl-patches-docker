+/**
+ * @enum
+ *
+ * :type:`ngtcp2_tp_entry_type` is the encoding type of a fingerprint
+ * custom transport parameter entry.
+ */
+typedef enum ngtcp2_tp_entry_type {
+  /**
+   * :macro:`NGTCP2_TP_ENTRY_TYPE_VARINT` is a varint parameter.
+   */
+  NGTCP2_TP_ENTRY_TYPE_VARINT,
+  /**
+   * :macro:`NGTCP2_TP_ENTRY_TYPE_CID` is a connection ID parameter
+   * whose value is the local source connection ID.
+   */
+  NGTCP2_TP_ENTRY_TYPE_CID,
+  /**
+   * :macro:`NGTCP2_TP_ENTRY_TYPE_RAW` is a parameter with raw bytes.
+   */
+  NGTCP2_TP_ENTRY_TYPE_RAW,
+  /**
+   * :macro:`NGTCP2_TP_ENTRY_TYPE_GREASE` is a GREASE parameter with
+   * randomly generated ID and value.
+   */
+  NGTCP2_TP_ENTRY_TYPE_GREASE,
+  /**
+   * :macro:`NGTCP2_TP_ENTRY_TYPE_VERSION_INFO` is the
+   * version_information parameter.
+   */
+  NGTCP2_TP_ENTRY_TYPE_VERSION_INFO,
+} ngtcp2_tp_entry_type;
+
+/**
+ * @struct
+ *
+ * :type:`ngtcp2_tp_entry` is a single entry of a fingerprint custom
+ * transport parameter list.  See
+ * :member:`ngtcp2_conn_set_local_transport_params_custom`.
+ */
+typedef struct ngtcp2_tp_entry {
+  /**
+   * :member:`type` is the encoding type of the entry.
+   */
+  ngtcp2_tp_entry_type type;
+  /**
+   * :member:`id` is the transport parameter ID.
+   */
+  uint64_t id;
+  /**
+   * :member:`value` is the value for
+   * :macro:`NGTCP2_TP_ENTRY_TYPE_VARINT` (varint value) and
+   * :macro:`NGTCP2_TP_ENTRY_TYPE_VERSION_INFO` (chosen version).
+   * Ignored otherwise.
+   */
+  uint64_t value;
+  /**
+   * :member:`data` is the value for
+   * :macro:`NGTCP2_TP_ENTRY_TYPE_RAW` (raw bytes) and
+   * :macro:`NGTCP2_TP_ENTRY_TYPE_VERSION_INFO` (available versions,
+   * four bytes each).  Ignored otherwise.
+   */
+  const uint8_t *data;
+  /**
+   * :member:`datalen` is the length of :member:`data`.
+   */
+  size_t datalen;
+} ngtcp2_tp_entry;
+
+/**
+ * @function
+ *
+ * `ngtcp2_conn_set_local_transport_params_custom` replaces the
+ * transport parameters sent in the TLS handshake with exactly the
+ * entries in |entries| of length |nentries|, in the given order.
+ *
+ * This is used to impersonate a specific QUIC transport parameter
+ * fingerprint.  The entries are copied, so |entries| (and any data it
+ * points to) can be freed after this call returns.
+ *
+ * Entry types:
+ *
+ * :macro:`NGTCP2_TP_ENTRY_TYPE_VARINT`
+ *     A varint parameter with the given |id| and |value|.
+ * :macro:`NGTCP2_TP_ENTRY_TYPE_CID`
+ *     A connection ID parameter with the given |id| and the local
+ *     source connection ID (typically empty for a zero-length SCID).
+ * :macro:`NGTCP2_TP_ENTRY_TYPE_RAW`
+ *     A parameter with the given |id| and raw bytes from |data|.
+ * :macro:`NGTCP2_TP_ENTRY_TYPE_GREASE`
+ *     A GREASE parameter: the ID and value are generated randomly at
+ *     encode time.
+ * :macro:`NGTCP2_TP_ENTRY_TYPE_VERSION_INFO`
+ *     The version_information parameter: |value| is the chosen
+ *     version, |data| the available versions (four bytes each),
+ *     written verbatim.
+ *
+ * This function returns 0 if it succeeds, or one of the following
+ * negative error codes:
+ *
+ * :macro:`NGTCP2_ERR_NOMEM`
+ *     Out of memory.
+ */
+NGTCP2_EXTERN int ngtcp2_conn_set_local_transport_params_custom(
+    ngtcp2_conn *conn, const ngtcp2_tp_entry *entries, size_t nentries);
+
 /**
  * @function
