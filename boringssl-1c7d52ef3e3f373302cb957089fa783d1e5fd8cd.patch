+int SSL_CTX_set_ciphersuites(SSL_CTX *ctx, char *str) {
+  if (!str) {
+    return 0;
+  }
+  bssl::Array<uint8_t> arr;
+  if (!arr.Init(strlen(str))) return 0;
+  int i = 0;
+  const char *l = str;
+  do {
+    arr[i++] = *l;
+  } while (*++l != '\0');
+  auto ctx_ = static_cast<SSLContext*>(ctx);
+  ctx_->cipher13_flag_list = std::move(arr);
+  return ctx_->cipher13_flag_list.empty() ? 0 : 1;
+}
+
+int SSL_CTX_set_extension_permutation(SSL_CTX *ctx, char *str) {
+  if (!str) {
+    return 0;
+  }
+  bssl::Array<uint8_t> arr;
+  if (!arr.Init(strlen(str))) return 0;
+  int i = 0;
+  const char *l = str;
+  do {
+    arr[i++] = *l - 1;
+  } while (*++l != '\0');
+  auto ctx_ = static_cast<SSLContext*>(ctx);
+  ctx_->extension_permutation = std::move(arr);
+  return ctx_->extension_permutation.empty() ? 0 : 1;
+}
+
