+/* Non-blocking SOCKS5 UDP ASSOCIATE state machine (RFC 1928), used for
+ * QUIC/HTTP3 over SOCKS5 proxies.
+ *
+ * The handshake never blocks: when it needs to wait for a socket event it
+ * returns CURLE_OK with *done = FALSE and the caller reports assoc->fd
+ * (direction in assoc->wait_read) to the transfer's socket supervision.
+ * While DNS is in flight (assoc->fd == CURL_SOCKET_BAD) the caller must
+ * schedule a retry via Curl_expire(). */
+
+enum s5a_state {
+  S5A_START = 0,
+  S5A_RESOLVE,        /* proxy name lookup */
+  S5A_CONNECTING,     /* TCP connect to proxy in flight */
+  S5A_SEND,           /* sending the current request */
+  S5A_RECV,           /* receiving the current reply part */
+  S5A_RESOLVE_RELAY,  /* resolving the relay address */
+  S5A_DONE
+};
+
+enum s5a_phase {
+  S5A_PH_GREETING,    /* send: VER, NMETHODS */
+  S5A_PH_METHOD,      /* recv: chosen auth method */
+  S5A_PH_AUTH_SEND,   /* send: username/password */
+  S5A_PH_AUTH_RECV,   /* recv: auth status */
+  S5A_PH_ASSOC_SEND,  /* send: UDP ASSOCIATE request */
+  S5A_PH_ASSOC_HEAD,  /* recv: reply header (VER, REP, RSV, ATYP) */
+  S5A_PH_ASSOC_ADDR   /* recv: BND.ADDR, BND.PORT */
+};
+
+static void s5a_build_associate(struct Curl_socks5_udp_assoc *s)
+{
+  /* Step 3: Send UDP ASSOCIATE request. RFC 1928: DST.ADDR/DST.PORT
+   * indicate the address and port the client expects to use for UDP
+   * datagrams, and 0.0.0.0:0 is the recommended value for clients that
+   * bind their own UDP socket. Some relays (residential proxy pools)
+   * reject associations requested for a hostname and silently drop the
+   * datagrams that follow, so always request 0.0.0.0:0. */
+  size_t idx = 0;
+  s->sendbuf[idx++] = 5; /* VER */
+  s->sendbuf[idx++] = 3; /* CMD: UDP ASSOCIATE */
+  s->sendbuf[idx++] = 0; /* RSV */
+  s->sendbuf[idx++] = 1; /* ATYP: IPv4 */
+  s->sendbuf[idx++] = 0; /* DST.ADDR: 0.0.0.0 */
+  s->sendbuf[idx++] = 0;
+  s->sendbuf[idx++] = 0;
+  s->sendbuf[idx++] = 0;
+  s->sendbuf[idx++] = 0; /* DST.PORT: 0 */
+  s->sendbuf[idx++] = 0;
+  s->sendlen = idx;
+  s->sendoff = 0;
+  s->phase = S5A_PH_ASSOC_SEND;
+  s->state = S5A_SEND;
+}
+
+/* Parse the reply of the current handshake phase and advance the state
+ * machine. Called once a full reply part has been read. */
+static CURLcode s5a_process_reply(struct Curl_easy *data,
+                                  struct Curl_socks5_udp_assoc *s,
+                                  const char *proxy_host, int proxy_port,
+                                  const char *proxy_user,
+                                  const char *proxy_passwd)
+{
+  size_t idx;
+
+  (void)proxy_port;
+
+  switch(s->phase) {
+  case S5A_PH_METHOD:
+    /* Step 2: Handle auth if needed */
+    if(s->recvbuf[0] != 5)
+      return CURLE_COULDNT_CONNECT;
+    if(s->recvbuf[1] == 2) {
+      /* Username/Password auth */
+      size_t ulen, plen;
+      ulen = proxy_user ? strlen(proxy_user) : 0;
+      plen = proxy_passwd ? strlen(proxy_passwd) : 0;
+      if(ulen > 255 || plen > 255)
+        return CURLE_COULDNT_CONNECT;
+
+      idx = 0;
+      s->sendbuf[idx++] = 1; /* auth version */
+      s->sendbuf[idx++] = (unsigned char)ulen;
+      if(ulen)
+        memcpy(&s->sendbuf[idx], proxy_user, ulen);
+      idx += ulen;
+      s->sendbuf[idx++] = (unsigned char)plen;
+      if(plen)
+        memcpy(&s->sendbuf[idx], proxy_passwd, plen);
+      idx += plen;
+      s->sendlen = idx;
+      s->sendoff = 0;
+      s->phase = S5A_PH_AUTH_SEND;
+      s->state = S5A_SEND;
+    }
+    else if(s->recvbuf[1] == 0) {
+      /* no auth needed: go straight to the ASSOCIATE request */
+      s5a_build_associate(s);
+    }
+    else {
+      infof(data, "SOCKS5 UDP ASSOCIATE: no acceptable auth method (%d)",
+            s->recvbuf[1]);
+      return CURLE_COULDNT_CONNECT;
+    }
+    break;
+
+  case S5A_PH_AUTH_RECV:
+    if(s->recvbuf[1] != 0) { /* status must be 0 */
+      infof(data, "SOCKS5 UDP ASSOCIATE: user rejected by proxy");
+      return CURLE_COULDNT_CONNECT;
+    }
+    s5a_build_associate(s);
+    break;
+
+  case S5A_PH_ASSOC_HEAD:
+    /* Step 4: Read UDP ASSOCIATE response */
+    if(s->recvbuf[0] != 5)
+      return CURLE_COULDNT_CONNECT;
+    if(s->recvbuf[1] != 0) {
+      infof(data, "SOCKS5 UDP ASSOCIATE reply error: %d", s->recvbuf[1]);
+      return CURLE_COULDNT_CONNECT;
+    }
+    /* BND.ADDR size depends on ATYP */
+    s->recvoff = 0;
+    if(s->recvbuf[3] == 1)       /* IPv4: 4 bytes addr + 2 bytes port */
+      s->recvlen = 6;
+    else if(s->recvbuf[3] == 3)  /* domain: length byte read first */
+      s->recvlen = 1;
+    else if(s->recvbuf[3] == 4)  /* IPv6: 16 bytes addr + 2 bytes port */
+      s->recvlen = 18;
+    else {
+      infof(data, "SOCKS5 UDP ASSOCIATE: unknown ATYP %d", s->recvbuf[3]);
+      return CURLE_COULDNT_CONNECT;
+    }
+    s->phase = S5A_PH_ASSOC_ADDR;
+    break;
+
+  case S5A_PH_ASSOC_ADDR:
+    if(s->recvlen == 1) {
+      /* that was the domain name length; read the name and port next */
+      size_t name_len = s->recvbuf[0];
+      if(name_len + 2 > sizeof(s->recvbuf))
+        return CURLE_COULDNT_CONNECT;
+      s->recvlen = name_len + 2;
+      s->recvoff = 0;
+      break; /* stay in ASSOC_ADDR and read the rest */
+    }
+    if(s->recvlen == 6) {
+      /* IPv4: 4 bytes addr + 2 bytes port */
+      msnprintf(s->relay_ip, sizeof(s->relay_ip), "%u.%u.%u.%u",
+                s->recvbuf[0], s->recvbuf[1], s->recvbuf[2], s->recvbuf[3]);
+      s->relay_port = (unsigned short)((s->recvbuf[4] << 8) | s->recvbuf[5]);
+    }
+    else if(s->recvlen == 18) {
+      /* IPv6: 16 bytes addr + 2 bytes port */
+      msnprintf(s->relay_ip, sizeof(s->relay_ip),
+                "%02x%02x:%02x%02x:%02x%02x:%02x%02x:"
+                "%02x%02x:%02x%02x:%02x%02x:%02x%02x",
+                s->recvbuf[0], s->recvbuf[1], s->recvbuf[2], s->recvbuf[3],
+                s->recvbuf[4], s->recvbuf[5], s->recvbuf[6], s->recvbuf[7],
+                s->recvbuf[8], s->recvbuf[9], s->recvbuf[10], s->recvbuf[11],
+                s->recvbuf[12], s->recvbuf[13], s->recvbuf[14], s->recvbuf[15]);
+      s->relay_port = (unsigned short)((s->recvbuf[16] << 8) | s->recvbuf[17]);
+    }
+    else {
+      /* domain name: name + 2 bytes port */
+      size_t name_len = s->recvlen - 2;
+      if(name_len < sizeof(s->relay_ip)) {
+        memcpy(s->relay_ip, s->recvbuf, name_len);
+        s->relay_ip[name_len] = '\0';
+      }
+      else {
+        strncpy(s->relay_ip, proxy_host, sizeof(s->relay_ip) - 1);
+        s->relay_ip[sizeof(s->relay_ip) - 1] = '\0';
+      }
+      s->relay_port = (unsigned short)((s->recvbuf[name_len] << 8) |
+                                       s->recvbuf[name_len + 1]);
+    }
+    /* RFC 1928: a BND.ADDR of all zeroes means the relay is on the
+     * proxy's own address. */
+    if(!strcmp(s->relay_ip, "0.0.0.0") || !strcmp(s->relay_ip, "::")) {
+      strncpy(s->relay_ip, proxy_host, sizeof(s->relay_ip) - 1);
+      s->relay_ip[sizeof(s->relay_ip) - 1] = '\0';
+    }
+    infof(data, "SOCKS5 UDP ASSOCIATE relay: %s:%u",
+          s->relay_ip, s->relay_port);
+    /* the proxy address list is no longer needed */
+    if(s->dns) {
+      Curl_resolv_unlock(data, s->dns);
+      s->dns = NULL;
+    }
+    s->state = S5A_RESOLVE_RELAY;
+    break;
+
+  default:
+    return CURLE_COULDNT_CONNECT; /* should not happen */
+  }
+  return CURLE_OK;
+}
+
+/* Copy the resolved relay address into assoc->relay_ai, ready for the
+ * QUIC UDP filter. */
+static CURLcode s5a_build_relay_ai(struct Curl_easy *data,
+                                   struct Curl_socks5_udp_assoc *s)
+{
+  struct Curl_addrinfo *hp;
+  struct sockaddr *sa = (struct sockaddr *)&s->relay_sa;
+  socklen_t sa_len;
+
+  hp = s->relay_dns->addr;
+  sa_len = hp->ai_addrlen;
+  if(sa_len > (socklen_t)sizeof(s->relay_sa))
+    sa_len = (socklen_t)sizeof(s->relay_sa);
+  memcpy(sa, hp->ai_addr, sa_len);
+
+  /* set the relay port */
+  if(hp->ai_family == AF_INET)
+    ((struct sockaddr_in *)(void *)sa)->sin_port = htons(s->relay_port);
+  else if(hp->ai_family == AF_INET6)
+    ((struct sockaddr_in6 *)(void *)sa)->sin6_port = htons(s->relay_port);
+  else
+    return CURLE_COULDNT_RESOLVE_PROXY;
+
+  memset(&s->relay_ai, 0, sizeof(s->relay_ai));
+  s->relay_ai.ai_family = hp->ai_family;
+  s->relay_ai.ai_socktype = SOCK_DGRAM;
+  s->relay_ai.ai_protocol = IPPROTO_UDP;
+  s->relay_ai.ai_addrlen = sa_len;
+  s->relay_ai.ai_addr = sa;
+
+  if(s->relay_dns) {
+    Curl_resolv_unlock(data, s->relay_dns);
+    s->relay_dns = NULL;
+  }
+  return CURLE_OK;
+}
+
+void Curl_SOCKS5_udp_assoc_init(struct Curl_socks5_udp_assoc *s)
+{
+  memset(s, 0, sizeof(*s));
+  s->fd = CURL_SOCKET_BAD;
+}
+
+void Curl_SOCKS5_udp_assoc_cleanup(struct Curl_easy *data,
+                                   struct Curl_socks5_udp_assoc *s)
+{
+  if(s->fd != CURL_SOCKET_BAD) {
+    sclose(s->fd);
+    s->fd = CURL_SOCKET_BAD;
+  }
+  if(s->dns) {
+    Curl_resolv_unlock(data, s->dns);
+    s->dns = NULL;
+  }
+  if(s->relay_dns) {
+    Curl_resolv_unlock(data, s->relay_dns);
+    s->relay_dns = NULL;
+  }
+}
+
+CURLcode Curl_SOCKS5_udp_assoc_step(struct Curl_easy *data,
+                                    struct Curl_socks5_udp_assoc *s,
+                                    const char *proxy_host, int proxy_port,
+                                    const char *proxy_user,
+                                    const char *proxy_passwd,
+                                    bool *done)
+{
+  CURLcode result = CURLE_OK;
+  timediff_t timeout_ms;
+  enum resolve_t rc;
+
+  *done = FALSE;
+
+  timeout_ms = Curl_timeleft(data, NULL, TRUE);
+  if(timeout_ms < 0)
+    return CURLE_OPERATION_TIMEDOUT;
+
+  for(;;) {
+    switch(s->state) {
+    case S5A_START:
+      /* Step 1: SOCKS5 version + authentication methods.
+       * Offer no-auth(0) and username/password(2). */
+      s->sendbuf[0] = 5; /* VER: SOCKS5 */
+      s->sendbuf[1] = 2; /* NMETHODS */
+      s->sendbuf[2] = 0; /* NO AUTHENTICATION REQUIRED */
+      s->sendbuf[3] = 2; /* USERNAME/PASSWORD */
+      s->sendlen = 4;
+      s->sendoff = 0;
+      s->phase = S5A_PH_GREETING;
+      s->state = S5A_RESOLVE;
+      /* fall through */
+
+    case S5A_RESOLVE:
+      /* Resolve proxy address. A PENDING result (threaded resolver /
+       * c-ares) starts a background lookup: we then poll it with
+       * Curl_resolv_check() instead of calling Curl_resolv() again,
+       * which would fire up a new thread per retry. */
+      if(!s->dns && !s->resolving) {
+        rc = Curl_resolv(data, proxy_host, proxy_port, TRUE, &s->dns);
+        if(rc == CURLRESOLV_ERROR)
+          return CURLE_COULDNT_RESOLVE_PROXY;
+        if(rc == CURLRESOLV_PENDING) {
+          s->resolving = TRUE;
+          Curl_expire(data, 100, EXPIRE_QUIC); /* fallback poll */
+          return CURLE_OK;
+        }
+      }
+      else if(s->resolving) {
+        result = Curl_resolv_check(data, &s->dns);
+        if(result)
+          return CURLE_COULDNT_RESOLVE_PROXY;
+        if(!s->dns) {
+          /* still in flight; the async resolver wakes us on completion */
+          Curl_expire(data, 100, EXPIRE_QUIC); /* fallback poll */
+          return CURLE_OK;
+        }
+        s->resolving = FALSE;
+      }
+      s->ai = s->dns->addr;
+      s->state = S5A_CONNECTING;
+      /* fall through */
+
+    case S5A_CONNECTING:
+      if(s->fd == CURL_SOCKET_BAD) {
+        /* Try each address until one connects */
+        while(s->ai) {
+          int rc2;
+
+          s->fd = socket(s->ai->ai_family, SOCK_STREAM, 0);
+          if(s->fd == CURL_SOCKET_BAD) {
+            s->ai = s->ai->ai_next;
+            continue;
+          }
+
+          /* Set non-blocking */
+          (void)curlx_nonblock(s->fd, TRUE);
+
+          rc2 = connect(s->fd, s->ai->ai_addr,
+                        (socklen_t)s->ai->ai_addrlen);
+          if(rc2 < 0 && SOCKERRNO != EINPROGRESS &&
+             SOCKERRNO != EWOULDBLOCK /* WSAEWOULDBLOCK on Windows */) {
+            sclose(s->fd);
+            s->fd = CURL_SOCKET_BAD;
+            s->ai = s->ai->ai_next;
+            continue;
+          }
+
+          if(rc2 < 0) {
+            /* connection attempt in flight: wait for writability */
+            s->wait_read = FALSE;
+            return CURLE_OK;
+          }
+          /* connected immediately */
+          s->state = S5A_SEND;
+          s->sendoff = 0;
+          break;
+        }
+        if(s->fd == CURL_SOCKET_BAD)
+          return CURLE_COULDNT_CONNECT;
+        break; /* continue with SEND in the next iteration */
+      }
+      /* we were waiting for the connect to complete: check the result */
+      {
+        int error = 0;
+        socklen_t error_len = sizeof(error);
+        if(getsockopt(s->fd, SOL_SOCKET, SO_ERROR, (char *)&error,
+                      &error_len) < 0 || error != 0) {
+          sclose(s->fd);
+          s->fd = CURL_SOCKET_BAD;
+          s->ai = s->ai->ai_next;
+          if(!s->ai)
+            return CURLE_COULDNT_CONNECT;
+          break; /* try the next address */
+        }
+        s->state = S5A_SEND;
+        s->sendoff = 0;
+      }
+      break;
+
+    case S5A_SEND: {
+      ssize_t nwritten;
+
+      nwritten = swrite(s->fd, (const char *)s->sendbuf + s->sendoff,
+                        s->sendlen - s->sendoff);
+      if(nwritten < 0) {
+        if(SOCKERRNO == EAGAIN || SOCKERRNO == EWOULDBLOCK) {
+          s->wait_read = FALSE;
+          return CURLE_OK; /* keep waiting for writability */
+        }
+        return CURLE_COULDNT_CONNECT;
+      }
+      s->sendoff += (size_t)nwritten;
+      if(s->sendoff < s->sendlen)
+        return CURLE_OK; /* keep waiting for writability */
+      /* request sent: move to the matching receive */
+      s->recvoff = 0;
+      switch(s->phase) {
+      case S5A_PH_GREETING:
+        s->phase = S5A_PH_METHOD;
+        s->recvlen = 2;
+        break;
+      case S5A_PH_AUTH_SEND:
+        s->phase = S5A_PH_AUTH_RECV;
+        s->recvlen = 2;
+        break;
+      case S5A_PH_ASSOC_SEND:
+        s->phase = S5A_PH_ASSOC_HEAD;
+        s->recvlen = 4;
+        break;
+      default:
+        return CURLE_COULDNT_CONNECT; /* should not happen */
+      }
+      s->state = S5A_RECV;
+      break; /* next iteration reads the reply */
+    }
+
+    case S5A_RECV: {
+      ssize_t nread;
+
+      nread = sread(s->fd, (char *)s->recvbuf + s->recvoff,
+                    s->recvlen - s->recvoff);
+      if(nread < 0) {
+        if(SOCKERRNO == EAGAIN || SOCKERRNO == EWOULDBLOCK) {
+          s->wait_read = TRUE;
+          return CURLE_OK; /* keep waiting for readability */
+        }
+        return CURLE_COULDNT_CONNECT;
+      }
+      if(nread == 0)
+        return CURLE_COULDNT_CONNECT; /* connection closed */
+      s->recvoff += (size_t)nread;
+      if(s->recvoff < s->recvlen)
+        return CURLE_OK; /* keep waiting for readability */
+      result = s5a_process_reply(data, s, proxy_host, proxy_port,
+                                 proxy_user, proxy_passwd);
+      if(result)
+        return result;
+      break; /* next iteration sends the next request or resolves the relay */
+    }
+
+    case S5A_RESOLVE_RELAY:
+      /* Resolve the relay address for the UDP filter. With the default
+       * (blocking) resolver this returns RESOLVED/ERROR; builds with a
+       * threaded resolver may return PENDING, in which case we poll the
+       * in-flight lookup with Curl_resolv_check() instead of re-resolving
+       * (each Curl_resolv() call would start a new thread). */
+      if(!s->relay_dns && !s->resolving) {
+        rc = Curl_resolv(data, s->relay_ip, s->relay_port, TRUE,
+                         &s->relay_dns);
+        if(rc == CURLRESOLV_ERROR)
+          return CURLE_COULDNT_RESOLVE_PROXY;
+        if(rc == CURLRESOLV_PENDING) {
+          s->resolving = TRUE;
+          Curl_expire(data, 100, EXPIRE_QUIC); /* fallback poll */
+          return CURLE_OK;
+        }
+      }
+      else if(s->resolving) {
+        result = Curl_resolv_check(data, &s->relay_dns);
+        if(result)
+          return CURLE_COULDNT_RESOLVE_PROXY;
+        if(!s->relay_dns) {
+          /* still in flight; the async resolver wakes us on completion */
+          Curl_expire(data, 100, EXPIRE_QUIC); /* fallback poll */
+          return CURLE_OK;
+        }
+        s->resolving = FALSE;
+      }
+      result = s5a_build_relay_ai(data, s);
+      if(result)
+        return result;
+      s->state = S5A_DONE;
+      /* fall through */
+
+    case S5A_DONE:
+      *done = TRUE;
+      return CURLE_OK;
+
+    default:
+      return CURLE_COULDNT_CONNECT; /* should not happen */
+    }
+  }
+}
