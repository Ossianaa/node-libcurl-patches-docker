+/* Build a SOCKS5 UDP header for datagram relay.
+ * Format: RSV(2) + FRAG(1) + ATYP(1) + DST.ADDR(var) + DST.PORT(2)
+ * Returns the header length or 0 on error. */
+size_t Curl_SOCKS5_build_udp_header(unsigned char *header_buf,
+                                    const char *target_host,
+                                    int target_port)
+{
+  unsigned char addr4[4];
+  unsigned char addr6[16];
+  size_t idx = 0;
+
+  header_buf[idx++] = 0; /* RSV */
+  header_buf[idx++] = 0; /* RSV */
+  header_buf[idx++] = 0; /* FRAG */
+
+  if(target_host && (1 == Curl_inet_pton(AF_INET, target_host, addr4))) {
+    header_buf[idx++] = 1; /* ATYP: IPv4 */
+    memcpy(&header_buf[idx], addr4, 4);
+    idx += 4;
+  }
+  else if(target_host && (1 == Curl_inet_pton(AF_INET6, target_host, addr6))) {
+    header_buf[idx++] = 4; /* ATYP: IPv6 */
+    memcpy(&header_buf[idx], addr6, 16);
+    idx += 16;
+  }
+  else if(target_host) {
+    size_t hostlen = strlen(target_host);
+    if(hostlen > 255)
+      hostlen = 255;
+    header_buf[idx++] = 3; /* ATYP: DOMAINNAME */
+    header_buf[idx++] = (unsigned char)hostlen;
+    memcpy(&header_buf[idx], target_host, hostlen);
+    idx += hostlen;
+  }
+  else {
+    return 0;
+  }
+
+  header_buf[idx++] = (unsigned char)((target_port >> 8) & 0xff);
+  header_buf[idx++] = (unsigned char)(target_port & 0xff);
+
+  return idx; /* total header length */
+}
