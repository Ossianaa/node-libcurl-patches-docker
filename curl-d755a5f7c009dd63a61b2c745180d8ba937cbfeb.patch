+/* Parse CURLOPT_HTTP3_FP_QUIC: "scid=<len>" sets the client source
+ * connection ID length (0-20). */
+static CURLcode quic_fp_parse_quic(struct cf_ngtcp2_ctx *ctx,
+                                   struct Curl_easy *data)
+{
+  const char *opt = data->set.str[STRING_HTTP3_FP_QUIC];
+  uint64_t len;
+
+  ctx->fp_scid_len = NGTCP2_MAX_CIDLEN;
+  if(!opt || !*opt)
+    return CURLE_OK;
+
+  if(strncmp(opt, "scid=", 5) || !quic_fp_parse_u64(opt + 5, &len) ||
+     len > NGTCP2_MAX_CIDLEN) {
+    failf(data, "invalid CURLOPT_HTTP3_FP_QUIC: '%s' "
+          "(expected \"scid=<0..%d>\")", opt, NGTCP2_MAX_CIDLEN);
+    return CURLE_BAD_FUNCTION_ARGUMENT;
+  }
+  ctx->fp_scid_len = (size_t)len;
+  infof(data, "HTTP/3 fp: source connection ID length %zu", ctx->fp_scid_len);
+  return CURLE_OK;
+}
+
+/* Parse CURLOPT_HTTP3_FP_SETTINGS: "id:value;id:value;..." in wire order.
+ * The keyword GREASE inserts a random unknown setting. Standard IDs also
+ * update the nghttp3 settings fields so protocol behaviour stays
+ * consistent with the advertised values. */
+static CURLcode quic_fp_parse_settings(struct cf_ngtcp2_ctx *ctx,
+                                       struct Curl_easy *data)
+{
+  const char *opt = data->set.str[STRING_HTTP3_FP_SETTINGS];
+  const char *p, *end;
+
+  ctx->fp_h3_settings_len = 0;
+  if(!opt || !*opt)
+    return CURLE_OK;
+
+  p = opt;
+  while(*p) {
+    const char *sep;
+    uint64_t id, value;
+    nghttp3_settings_entry *ent;
+
+    if(ctx->fp_h3_settings_len >= NGHTTP3_FP_MAX_SETTINGS) {
+      failf(data, "too many CURLOPT_HTTP3_FP_SETTINGS entries");
+      return CURLE_BAD_FUNCTION_ARGUMENT;
+    }
+    sep = strchr(p, ';');
+    end = sep ? sep : p + strlen(p);
+
+    if(end - p >= 6 && !strncmp(p, "GREASE", 6)) {
+      ent = &ctx->fp_h3_settings[ctx->fp_h3_settings_len++];
+      quic_fp_grease_settings_id(data, &ent->id);
+      quic_fp_grease_u64(data, &ent->value);
+    }
+    else {
+      const char *colon = memchr(p, ':', (size_t)(end - p));
+      char idbuf[32];
+      char valbuf[32];
+
+      if(!colon || (size_t)(colon - p) >= sizeof(idbuf) ||
+         (size_t)(end - colon - 1) >= sizeof(valbuf)) {
+        failf(data, "invalid CURLOPT_HTTP3_FP_SETTINGS entry: '%.*s'",
+              (int)(end - p), p);
+        return CURLE_BAD_FUNCTION_ARGUMENT;
+      }
+      memcpy(idbuf, p, (size_t)(colon - p));
+      idbuf[colon - p] = '\0';
+      memcpy(valbuf, colon + 1, (size_t)(end - colon - 1));
+      valbuf[end - colon - 1] = '\0';
+      if(!quic_fp_parse_u64(idbuf, &id) || !quic_fp_parse_u64(valbuf, &value)) {
+        failf(data, "invalid CURLOPT_HTTP3_FP_SETTINGS entry: '%.*s'",
+              (int)(end - p), p);
+        return CURLE_BAD_FUNCTION_ARGUMENT;
+      }
+      ent = &ctx->fp_h3_settings[ctx->fp_h3_settings_len++];
+      ent->id = id;
+      ent->value = value;
+    }
+
+    if(!sep)
+      break;
+    p = sep + 1;
+  }
+  infof(data, "HTTP/3 fp: %zu SETTINGS entries configured",
+        ctx->fp_h3_settings_len);
+  return CURLE_OK;
+}
