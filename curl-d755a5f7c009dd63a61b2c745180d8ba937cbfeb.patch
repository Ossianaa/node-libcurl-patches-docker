+/* Non-blocking SOCKS5 UDP ASSOCIATE (RFC 1928) for QUIC/HTTP3 over SOCKS5.
+ *
+ * The handshake runs as a state machine so it never blocks the caller:
+ * Curl_SOCKS5_udp_assoc_step() returns CURLE_OK with *done = FALSE while
+ * it waits for socket events or DNS resolution, and CURLE_OK with
+ * *done = TRUE once the UDP relay address is known.
+ *
+ * While *done is FALSE the caller must keep the transfer driven:
+ *   - when assoc->fd is a valid socket, report it (and the direction in
+ *     assoc->wait_read) to the transfer's socket supervision
+ *     (cf->cft->get_select_socks);
+ *   - when assoc->fd is CURL_SOCKET_BAD (DNS in progress), schedule a
+ *     retry via Curl_expire().
+ *
+ * After *done is TRUE, assoc->relay_ip/relay_port hold the relay address,
+ * assoc->relay_ai the resolved relay address for the QUIC UDP filter, and
+ * assoc->fd is the TCP control connection that MUST stay open for the
+ * lifetime of the relay session (RFC 1928). */
+struct Curl_socks5_udp_assoc {
+  int state;                    /* state machine step, internal */
+  int phase;                    /* which handshake message we are on */
+  curl_socket_t fd;             /* TCP control connection to proxy */
+  bool wait_read;               /* current wait direction for socket API */
+  unsigned char sendbuf[1024];  /* current outbound handshake request */
+  size_t sendlen;
+  size_t sendoff;
+  unsigned char recvbuf[1024];  /* current inbound handshake response */
+  size_t recvlen;               /* bytes to read for the current part */
+  size_t recvoff;
+  struct Curl_dns_entry *dns;   /* proxy DNS entry, locked */
+  struct Curl_addrinfo *ai;     /* next address to try connecting to */
+  bool resolving;               /* a lookup is in flight: poll it via
+                                   Curl_resolv_check, never re-resolve */
+  char relay_ip[64];            /* BND.ADDR of the UDP relay */
+  unsigned short relay_port;
+  struct Curl_dns_entry *relay_dns; /* relay DNS entry, locked */
+  struct Curl_addrinfo relay_ai;    /* resolved relay address for the UDP filter */
+  struct sockaddr_storage relay_sa; /* backing storage for relay_ai */
+};
+
+void Curl_SOCKS5_udp_assoc_init(struct Curl_socks5_udp_assoc *s);
+CURLcode Curl_SOCKS5_udp_assoc_step(struct Curl_easy *data,
