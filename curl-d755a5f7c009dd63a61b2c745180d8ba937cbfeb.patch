+/* Parse one CURLOPT_HTTP3_FP_TRANSPORT_PARAMS value into the next entry.
+ * Returns TRUE on success. */
+static bool quic_fp_parse_tp_value(struct cf_ngtcp2_ctx *ctx,
+                                   struct Curl_easy *data,
+                                   uint64_t id,
+                                   const char *val, size_t vallen,
+                                   ngtcp2_tp_entry *ent)
+{
+  if(vallen == 6 && !strncmp(val, "GREASE", 6)) {
+    ent->type = NGTCP2_TP_ENTRY_TYPE_GREASE;
