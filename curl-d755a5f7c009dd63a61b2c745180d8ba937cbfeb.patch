+    return 0; /* too short */
+
+  /* RSV must be 0x00 0x00 */
+  if(buf[0] != 0 || buf[1] != 0)
+    return 0;
+
+  /* FRAG must be 0x00 (no fragmentation support for simplicity) */
+  if(buf[2] != 0)
+    return 0;
+
+  /* ATYP */
+  switch(buf[3]) {
+  case 0x01: /* IPv4 */
+    hdrlen = 6 + 4; /* RSV(2)+FRAG(1)+ATYP(1)+IPv4(4)+PORT(2) */
+    break;
+  case 0x03: /* DOMAINNAME */
+    if(buflen < 5)
+      return 0;
+    hdrlen = 6 + buf[4]; /* RSV(2)+FRAG(1)+ATYP(1)+len(1)+name(var)+PORT(2) */
+    break;
+  case 0x04: /* IPv6 */
+    hdrlen = 6 + 16; /* RSV(2)+FRAG(1)+ATYP(1)+IPv6(16)+PORT(2) */
+    break;
+  default:
+    return 0; /* unknown ATYP */
+  }
+
+  if(buflen < hdrlen)
+    return 0;
+
+  return hdrlen;
+}
