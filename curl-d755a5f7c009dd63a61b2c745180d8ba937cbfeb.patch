+/* Parse CURLOPT_HTTP3_FP_TRANSPORT_PARAMS: "id:value;id:value;..." in wire
+ * order, and mirror the standard values into the ngtcp2 transport params so
+ * flow control etc. matches what is advertised. */
+static CURLcode quic_fp_parse_tp(struct cf_ngtcp2_ctx *ctx,
+                                 struct Curl_easy *data,
+                                 ngtcp2_transport_params *t)
+{
+  const char *opt = data->set.str[STRING_HTTP3_FP_TRANSPORT_PARAMS];
+  const char *p;
+
+  ctx->fp_tp_len = 0;
+  ctx->fp_tp_blob_len = 0;
+  if(!opt || !*opt)
+    return CURLE_OK;
+
+  p = opt;
+  while(*p) {
+    const char *sep = strchr(p, ';');
+    const char *end = sep ? sep : p + strlen(p);
+    const char *colon = memchr(p, ':', (size_t)(end - p));
+    ngtcp2_tp_entry *ent;
+    uint64_t id;
+
+    if(ctx->fp_tp_len >= NGTCP2_FP_MAX_TP) {
+      failf(data, "too many CURLOPT_HTTP3_FP_TRANSPORT_PARAMS entries");
+      return CURLE_BAD_FUNCTION_ARGUMENT;
+    }
+    ent = &ctx->fp_tp[ctx->fp_tp_len];
+    ent->id = 0;
+    ent->value = 0;
+    ent->data = NULL;
+    ent->datalen = 0;
+    if(!colon && end - p == 6 && !strncmp(p, "GREASE", 6)) {
+      /* bare GREASE transport parameter */
+      ent->type = NGTCP2_TP_ENTRY_TYPE_GREASE;
+      ctx->fp_tp_len++;
+      if(!sep)
+        break;
+      p = sep + 1;
+      continue;
+    }
+    if(colon && (size_t)(colon - p) < 32) {
+      char idbuf[32];
+      memcpy(idbuf, p, (size_t)(colon - p));
+      idbuf[colon - p] = '\0';
+      if(quic_fp_parse_u64(idbuf, &id)) {
+        ent->id = id;
+        if(!quic_fp_parse_tp_value(ctx, data, id, colon + 1,
+                                   (size_t)(end - colon - 1), ent))
+          return CURLE_BAD_FUNCTION_ARGUMENT;
+        ctx->fp_tp_len++;
+
+        /* mirror standard values so internal flow control stays sane */
+        switch(id) {
+        case 0x1: /* max_idle_timeout (ms) -> ngtcp2 duration (ns) */
+          if(ent->type == NGTCP2_TP_ENTRY_TYPE_VARINT)
+            t->max_idle_timeout = ent->value * NGTCP2_SECONDS / 1000;
+          break;
+        case 0x3:
+          if(ent->type == NGTCP2_TP_ENTRY_TYPE_VARINT)
+            t->max_udp_payload_size = ent->value;
+          break;
+        case 0x4:
+          if(ent->type == NGTCP2_TP_ENTRY_TYPE_VARINT)
+            t->initial_max_data = ent->value;
+          break;
+        case 0x5:
+          if(ent->type == NGTCP2_TP_ENTRY_TYPE_VARINT)
+            t->initial_max_stream_data_bidi_local = ent->value;
+          break;
+        case 0x6:
+          if(ent->type == NGTCP2_TP_ENTRY_TYPE_VARINT)
+            t->initial_max_stream_data_bidi_remote = ent->value;
+          break;
+        case 0x7:
+          if(ent->type == NGTCP2_TP_ENTRY_TYPE_VARINT)
+            t->initial_max_stream_data_uni = ent->value;
+          break;
+        case 0x8:
+          if(ent->type == NGTCP2_TP_ENTRY_TYPE_VARINT)
+            t->initial_max_streams_bidi = ent->value;
+          break;
+        case 0x9:
+          if(ent->type == NGTCP2_TP_ENTRY_TYPE_VARINT)
+            t->initial_max_streams_uni = ent->value;
+          break;
+        case 0x20: /* max_datagram_frame_size */
+          if(ent->type == NGTCP2_TP_ENTRY_TYPE_VARINT)
+            t->max_datagram_frame_size = ent->value;
+          break;
+        default:
+          break;
+        }
+        if(!sep)
+          break;
+        p = sep + 1;
+        continue;
+      }
+    }
+    failf(data, "invalid CURLOPT_HTTP3_FP_TRANSPORT_PARAMS entry: '%.*s'",
+          (int)(end - p), p);
+    return CURLE_BAD_FUNCTION_ARGUMENT;
+  }
+  if(ctx->fp_rand && ctx->fp_tp_len > 1) {
+    /* Chrome randomizes the transport parameter order per connection */
+    size_t idx[NGTCP2_FP_MAX_TP];
+    ngtcp2_tp_entry shuffled[NGTCP2_FP_MAX_TP];
+    size_t i;
+
+    for(i = 0; i < ctx->fp_tp_len; ++i)
+      idx[i] = i;
+    quic_fp_shuffle(data, idx, ctx->fp_tp_len);
+    for(i = 0; i < ctx->fp_tp_len; ++i)
+      shuffled[i] = ctx->fp_tp[idx[i]];
+    memcpy(ctx->fp_tp, shuffled, sizeof(ngtcp2_tp_entry) * ctx->fp_tp_len);
+  }
+  infof(data, "HTTP/3 fp: %zu transport parameters configured",
+        ctx->fp_tp_len);
+  return CURLE_OK;
+}
