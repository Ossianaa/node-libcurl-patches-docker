+      failf(data, "CURLOPT_HTTP3_FP_TRANSPORT_PARAMS too long");
+      return FALSE;
+    }
+    ent->type = NGTCP2_TP_ENTRY_TYPE_RAW;
+    ent->value = value;
+    ent->data = ctx->fp_tp_blob + ctx->fp_tp_blob_len;
+    ent->datalen = 4;
+    ctx->fp_tp_blob[ctx->fp_tp_blob_len + 0] = (uint8_t)(value >> 24);
+    ctx->fp_tp_blob[ctx->fp_tp_blob_len + 1] = (uint8_t)(value >> 16);
+    ctx->fp_tp_blob[ctx->fp_tp_blob_len + 2] = (uint8_t)(value >> 8);
+    ctx->fp_tp_blob[ctx->fp_tp_blob_len + 3] = (uint8_t)value;
+    ctx->fp_tp_blob_len += 4;
+    return TRUE;
+  }
