+/* Parse one 64-bit unsigned value: decimal or 0x-prefixed hex.
+ * Returns TRUE on success. */
+static bool quic_fp_parse_u64(const char *str, uint64_t *pval)
+{
+  char *endptr = NULL;
+
+  if(!str || !*str)
+    return FALSE;
+  errno = 0;
+  *pval = strtoull(str, &endptr, 0);
+  if(errno || endptr == str || *endptr)
+    return FALSE;
+  return TRUE;
+}
+
+/* Fill |buf| (len bytes) with random data. */
+static CURLcode quic_fp_rand(struct Curl_easy *data, uint8_t *buf, size_t len)
+{
+  return Curl_rand(data, buf, len);
+}
+
+/* Fill |pval| with a random GREASE-style value. */
+static void quic_fp_grease_u64(struct Curl_easy *data, uint64_t *pval)
+{
+  uint8_t buf[8];
+
+  if(Curl_rand(data, buf, sizeof(buf)) != CURLE_OK)
+    memset(buf, 0, sizeof(buf));
+  buf[0] = (uint8_t)(0x10 | (buf[0] & 0x0f));
+  *pval = 0;
+  {
+    size_t i;
+    for(i = 0; i < sizeof(buf); ++i)
+      *pval = (*pval << 8) | buf[i];
+  }
+}
+
+/* Fisher-Yates shuffle of |idx[0..n-1]| using curl's RNG. */
+static void quic_fp_shuffle(struct Curl_easy *data, size_t *idx, size_t n)
+{
+  size_t i;
+
+  for(i = n - 1; i > 0; --i) {
+    uint8_t rbuf[2];
+    size_t j;
+
+    if(Curl_rand(data, rbuf, sizeof(rbuf)) != CURLE_OK)
+      rbuf[0] = rbuf[1] = 0;
+    j = (size_t)(rbuf[0] | ((size_t)rbuf[1] << 8)) % (i + 1);
+    {
+      size_t t = idx[i];
+      idx[i] = idx[j];
+      idx[j] = t;
+    }
+  }
+}
+
+/* Fill |pval| with a GREASE SETTINGS ID that fingerprinting services
+ * recognize as GREASE.  The two known-good IDs are the ones observed in
+ * the Chrome 151 samples (0x19b4c8cd6 and 0x17c1d7fd48); Chrome picks
+ * one per connection, so we rotate randomly. */
+static void quic_fp_grease_settings_id(struct Curl_easy *data, uint64_t *pval)
+{
+  static const uint64_t known_grease_ids[2] = {
+      UINT64_C(0x19b4c8cd6), UINT64_C(0x17c1d7fd48)};
+  uint8_t r;
+
+  if(Curl_rand(data, &r, 1) != CURLE_OK)
+    r = 0;
+  *pval = known_grease_ids[r & 1];
+}
