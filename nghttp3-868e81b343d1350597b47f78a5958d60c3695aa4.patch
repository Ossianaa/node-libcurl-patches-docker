@@ -332,6 +332,20 @@ static int conn_new(nghttp3_conn **pconn, int server, int callbacks_version,
   nghttp3_qpack_encoder_set_indexing_strat(&conn->qenc,
                                            settings->qpack_indexing_strat);
 
+  /* Fingerprint profile: if the local settings advertise a QPACK
+     dynamic table capacity, size the encoder accordingly (as Chrome
+     does) so the encoder stream carries the capacity instruction and
+     stays consistent with the advertised SETTINGS. */
+  if (settings->qpack_max_dtable_capacity) {
+    size_t enc_cap = settings->qpack_max_dtable_capacity;
+
+    if (settings->qpack_encoder_max_dtable_capacity &&
+        enc_cap > settings->qpack_encoder_max_dtable_capacity) {
+      enc_cap = settings->qpack_encoder_max_dtable_capacity;
+    }
+    nghttp3_qpack_encoder_set_max_dtable_capacity(&conn->qenc, enc_cap);
+  }
+
