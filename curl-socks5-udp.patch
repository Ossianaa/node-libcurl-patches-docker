+/* Wait for a socket to become readable/writable within the timeout.
+ * Returns 1 if ready, 0 on timeout, -1 on error. */
+static int socks5_wait_sock(curl_socket_t sockfd, bool readable,
+                            timediff_t timeout_ms)
+{
+  fd_set fds;
+  struct timeval tv;
+  int rc;
+
+  if(timeout_ms < 0)
+    timeout_ms = 30000; /* 30s default */
+  if(timeout_ms > 30000)
+    timeout_ms = 30000; /* cap at 30s per wait */
+
+  FD_ZERO(&fds);
+  FD_SET(sockfd, &fds);
+  tv.tv_sec = (long)(timeout_ms / 1000);
+  tv.tv_usec = (long)((timeout_ms % 1000) * 1000);
+
+  if(readable)
+    rc = select((int)sockfd + 1, &fds, NULL, NULL, &tv);
+  else
+    rc = select((int)sockfd + 1, NULL, &fds, NULL, &tv);
+
+  return (rc > 0) ? 1 : (rc < 0 ? -1 : 0);
+}
+
+/* Receive exactly len bytes from the socket, handling EAGAIN and partial
+ * reads. Returns CURLE_OK on success. */
+static CURLcode socks5_recv_all(curl_socket_t sockfd, unsigned char *buf,
+                                size_t len)
+{
+  size_t got = 0;
+
+  while(got < len) {
+    ssize_t n = sread(sockfd, buf + got, len - got);
+    if(n < 0) {
+      if(SOCKERRNO == EAGAIN || SOCKERRNO == EWOULDBLOCK) {
+        if(!socks5_wait_sock(sockfd, TRUE, 30000))
+          return CURLE_OPERATION_TIMEDOUT;
+        continue;
+      }
+      return CURLE_COULDNT_CONNECT;
+    }
+    if(n == 0)
+      return CURLE_COULDNT_CONNECT; /* connection closed */
+    got += (size_t)n;
+  }
+  return CURLE_OK;
+}
+
+/* Send all bytes, handling EAGAIN and partial writes.
+ * Returns CURLE_OK on success. */
+static CURLcode socks5_send_all(curl_socket_t sockfd,
+                                const unsigned char *buf, size_t len)
+{
+  size_t sent = 0;
+
+  while(sent < len) {
+    ssize_t n = swrite(sockfd, buf + sent, len - sent);
+    if(n < 0) {
+      if(SOCKERRNO == EAGAIN || SOCKERRNO == EWOULDBLOCK) {
+        if(!socks5_wait_sock(sockfd, FALSE, 30000))
+          return CURLE_OPERATION_TIMEDOUT;
+        continue;
+      }
+      return CURLE_COULDNT_CONNECT;
+    }
+    if(n == 0)
+      return CURLE_COULDNT_CONNECT; /* connection closed */
+    sent += (size_t)n;
+  }
+  return CURLE_OK;
+}
+
+/*
+ * SOCKS5 UDP ASSOCIATE - for QUIC/HTTP3 proxy support.
+ *
+ * This function performs the SOCKS5 UDP ASSOCIATE handshake (RFC 1928)
+ * to obtain a UDP relay address from the SOCKS5 proxy.
+ *
+ * After successful completion, relay_ip and relay_port are filled with
+ * the proxy's UDP relay address/port, and *control_fd receives the TCP
+ * control connection socket which MUST be kept open for the lifetime of
+ * the UDP relay session (RFC 1928).
+ *
+ * The caller should then wrap each UDP datagram with a SOCKS5 UDP header:
+ *   +----+------+------+----------+----------+------+
+ *   |RSV | FRAG | ATYP | DST.ADDR | DST.PORT | DATA |
+ *   +----+------+------+----------+----------+------+
+ *   | 2  |  1   |  1   | Variable |    2     | Var  |
+ *   +----+------+------+----------+----------+------+
+ *
+ * Returns CURLE_OK on success.
+ */
+CURLcode Curl_SOCKS5_udp_associate(struct Curl_easy *data,
+                                   const char *proxy_host, int proxy_port,
+                                   const char *proxy_user,
+                                   const char *proxy_passwd,
+                                   const char *target_host, int target_port,
+                                   char *relay_ip, size_t relay_ip_len,
+                                   unsigned short *relay_port,
+                                   curl_socket_t *control_fd)
+{
+  unsigned char buf[1024];
+  CURLcode result;
+  curl_socket_t sockfd = CURL_SOCKET_BAD;
+  int rc;
+  timediff_t timeout_ms;
+  size_t hostname_len;
+  struct Curl_addrinfo *ai = NULL;
+  struct Curl_dns_entry *dns = NULL;
+  enum resolve_t rc_resolve;
+
+  *control_fd = CURL_SOCKET_BAD;
+
+  timeout_ms = Curl_timeleft(data, NULL, TRUE);
+  if(timeout_ms < 0)
+    return CURLE_OPERATION_TIMEDOUT;
+
+  /* Resolve proxy address */
+  rc_resolve = Curl_resolv(data, proxy_host, proxy_port, TRUE, &dns);
+  if(rc_resolve == CURLRESOLV_ERROR)
+    return CURLE_COULDNT_RESOLVE_PROXY;
+  if(rc_resolve == CURLRESOLV_PENDING)
+    return CURLE_AGAIN;
+
+  /* Try each address until one connects */
+  for(ai = dns->addr; ai; ai = ai->ai_next) {
+    sockfd = socket(ai->ai_family, SOCK_STREAM, 0);
+    if(sockfd == CURL_SOCKET_BAD)
+      continue;
+
+    /* Set non-blocking */
+    (void)curlx_nonblock(sockfd, TRUE);
+
+    rc = connect(sockfd, ai->ai_addr, (socklen_t)ai->ai_addrlen);
+    if(rc < 0 && SOCKERRNO != EINPROGRESS &&
+       SOCKERRNO != EWOULDBLOCK /* WSAEWOULDBLOCK on Windows */) {
+      sclose(sockfd);
+      sockfd = CURL_SOCKET_BAD;
+      continue;
+    }
+
+    /* Wait for connection to complete */
+    if(rc < 0) {
+      int error = 0;
+      socklen_t error_len = sizeof(error);
+      if(!socks5_wait_sock(sockfd, FALSE, timeout_ms)) {
+        sclose(sockfd);
+        sockfd = CURL_SOCKET_BAD;
+        continue;
+      }
+      if(getsockopt(sockfd, SOL_SOCKET, SO_ERROR, (char *)&error,
+                    &error_len) < 0 || error != 0) {
+        sclose(sockfd);
+        sockfd = CURL_SOCKET_BAD;
+        continue;
+      }
+    }
+    break; /* connected */
+  }
+
+  if(sockfd == CURL_SOCKET_BAD) {
+    Curl_resolv_unlock(data, dns);
+    return CURLE_COULDNT_CONNECT;
+  }
+  Curl_resolv_unlock(data, dns);
+
+  /* Step 1: SOCKS5 version + authentication methods.
+   * Offer no-auth(0) and username/password(2). */
+  buf[0] = 5; /* VER: SOCKS5 */
+  buf[1] = 2; /* NMETHODS */
+  buf[2] = 0; /* NO AUTHENTICATION REQUIRED */
+  buf[3] = 2; /* USERNAME/PASSWORD */
+  result = socks5_send_all(sockfd, buf, 4);
+  if(result)
+    goto out;
+
+  /* Read auth method response */
+  result = socks5_recv_all(sockfd, buf, 2);
+  if(result)
+    goto out;
+  if(buf[0] != 5) {
+    result = CURLE_COULDNT_CONNECT;
+    goto out;
+  }
+
+  /* Step 2: Handle auth if needed */
+  if(buf[1] == 2) {
+    /* Username/Password auth */
+    size_t ulen, plen, idx;
+    ulen = proxy_user ? strlen(proxy_user) : 0;
+    plen = proxy_passwd ? strlen(proxy_passwd) : 0;
+    if(ulen > 255 || plen > 255) {
+      result = CURLE_COULDNT_CONNECT;
+      goto out;
+    }
+
+    idx = 0;
+    buf[idx++] = 1; /* auth version */
+    buf[idx++] = (unsigned char)ulen;
+    if(ulen)
+      memcpy(&buf[idx], proxy_user, ulen);
+    idx += ulen;
+    buf[idx++] = (unsigned char)plen;
+    if(plen)
+      memcpy(&buf[idx], proxy_passwd, plen);
+    idx += plen;
+
+    result = socks5_send_all(sockfd, buf, idx);
+    if(result)
+      goto out;
+
+    result = socks5_recv_all(sockfd, buf, 2);
+    if(result)
+      goto out;
+    if(buf[1] != 0) { /* status must be 0 */
+      infof(data, "SOCKS5 UDP ASSOCIATE: user rejected by proxy");
+      result = CURLE_COULDNT_CONNECT;
+      goto out;
+    }
+  }
+  else if(buf[1] != 0) {
+    /* No acceptable auth method */
+    infof(data, "SOCKS5 UDP ASSOCIATE: no acceptable auth method (%d)",
+          buf[1]);
+    result = CURLE_COULDNT_CONNECT;
+    goto out;
+  }
+
+  /* Step 3: Send UDP ASSOCIATE request with target as destination */
+  hostname_len = strlen(target_host);
+  {
+    size_t idx = 0;
+    unsigned char addr4[4];
+    buf[idx++] = 5; /* VER */
+    buf[idx++] = 3; /* CMD: UDP ASSOCIATE */
+    buf[idx++] = 0; /* RSV */
+
+    if(1 == Curl_inet_pton(AF_INET, target_host, addr4)) {
+      buf[idx++] = 1; /* ATYP: IPv4 */
+      memcpy(&buf[idx], addr4, 4);
+      idx += 4;
+    }
+    else {
+      buf[idx++] = 3; /* ATYP: DOMAINNAME */
+      if(hostname_len > 255)
+        hostname_len = 255;
+      buf[idx++] = (unsigned char)hostname_len;
+      memcpy(&buf[idx], target_host, hostname_len);
+      idx += hostname_len;
+    }
+    buf[idx++] = (unsigned char)((target_port >> 8) & 0xff);
+    buf[idx++] = (unsigned char)(target_port & 0xff);
+
+    result = socks5_send_all(sockfd, buf, idx);
+    if(result)
+      goto out;
+  }
+
+  /* Step 4: Read UDP ASSOCIATE response */
+  {
+    unsigned char reply[4];
+    unsigned char addr_buf[260];
+
+    result = socks5_recv_all(sockfd, reply, 4);
+    if(result)
+      goto out;
+
+    if(reply[0] != 5) {
+      result = CURLE_COULDNT_CONNECT;
+      goto out;
+    }
+
+    if(reply[1] != 0) {
+      infof(data, "SOCKS5 UDP ASSOCIATE reply error: %d", reply[1]);
+      result = CURLE_COULDNT_CONNECT;
+      goto out;
+    }
+
+    /* Read BND.ADDR based on ATYP */
+    if(reply[3] == 1) {
+      /* IPv4: 4 bytes addr + 2 bytes port */
+      result = socks5_recv_all(sockfd, addr_buf, 6);
+      if(result)
+        goto out;
+      msnprintf(relay_ip, relay_ip_len, "%u.%u.%u.%u",
+                addr_buf[0], addr_buf[1], addr_buf[2], addr_buf[3]);
+      *relay_port = (unsigned short)((addr_buf[4] << 8) | addr_buf[5]);
+    }
+    else if(reply[3] == 3) {
+      /* Domain name: 1 byte length + name + 2 bytes port */
+      unsigned char name_len;
+      result = socks5_recv_all(sockfd, addr_buf, 1);
+      if(result)
+        goto out;
+      name_len = addr_buf[0];
+      result = socks5_recv_all(sockfd, addr_buf, name_len + 2);
+      if(result)
+        goto out;
+      if(name_len < relay_ip_len) {
+        memcpy(relay_ip, addr_buf, name_len);
+        relay_ip[name_len] = '\0';
+      }
+      else {
+        strncpy(relay_ip, proxy_host, relay_ip_len - 1);
+        relay_ip[relay_ip_len - 1] = '\0';
+      }
+      *relay_port = (unsigned short)(
+        (addr_buf[name_len] << 8) | addr_buf[name_len + 1]);
+    }
+    else if(reply[3] == 4) {
+      /* IPv6: 16 bytes addr + 2 bytes port */
+      result = socks5_recv_all(sockfd, addr_buf, 18);
+      if(result)
+        goto out;
+      msnprintf(relay_ip, relay_ip_len,
+                "%02x%02x:%02x%02x:%02x%02x:%02x%02x:"
+                "%02x%02x:%02x%02x:%02x%02x:%02x%02x",
+                addr_buf[0], addr_buf[1], addr_buf[2], addr_buf[3],
+                addr_buf[4], addr_buf[5], addr_buf[6], addr_buf[7],
+                addr_buf[8], addr_buf[9], addr_buf[10], addr_buf[11],
+                addr_buf[12], addr_buf[13], addr_buf[14], addr_buf[15]);
+      *relay_port = (unsigned short)((addr_buf[16] << 8) | addr_buf[17]);
+    }
+    else {
+      infof(data, "SOCKS5 UDP ASSOCIATE: unknown ATYP %d", reply[3]);
+      result = CURLE_COULDNT_CONNECT;
+      goto out;
+    }
+
+    infof(data, "SOCKS5 UDP ASSOCIATE relay: %s:%u",
+          relay_ip, *relay_port);
+  }
+
+  /* Success - hand the TCP control connection to the caller.
+   * It MUST stay open for the UDP relay to keep working. */
+  *control_fd = sockfd;
+  return CURLE_OK;
+
+out:
+  sclose(sockfd);
+  return result;
+}
+
+/* Build a SOCKS5 UDP header for datagram relay.
+ * Format: RSV(2) + FRAG(1) + ATYP(1) + DST.ADDR(var) + DST.PORT(2)
+ * Returns the header length or 0 on error. */
+size_t Curl_SOCKS5_build_udp_header(unsigned char *header_buf,
+                                    const char *target_host,
+                                    int target_port)
+{
+  unsigned char addr4[4];
+  size_t idx = 0;
+
+  header_buf[idx++] = 0; /* RSV */
+  header_buf[idx++] = 0; /* RSV */
+  header_buf[idx++] = 0; /* FRAG */
+
+  if(target_host && (1 == Curl_inet_pton(AF_INET, target_host, addr4))) {
+    header_buf[idx++] = 1; /* ATYP: IPv4 */
+    memcpy(&header_buf[idx], addr4, 4);
+    idx += 4;
+  }
+  else if(target_host) {
+    size_t hostlen = strlen(target_host);
+    if(hostlen > 255)
+      hostlen = 255;
+    header_buf[idx++] = 3; /* ATYP: DOMAINNAME */
+    header_buf[idx++] = (unsigned char)hostlen;
+    memcpy(&header_buf[idx], target_host, hostlen);
+    idx += hostlen;
+  }
+  else {
+    return 0;
+  }
+
+  header_buf[idx++] = (unsigned char)((target_port >> 8) & 0xff);
+  header_buf[idx++] = (unsigned char)(target_port & 0xff);
+
+  return idx; /* total header length */
+}
